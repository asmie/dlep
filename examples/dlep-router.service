[Unit]
Description=DLEP router-side daemon (RFC 8175)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dlep-router --config /etc/dlep/router.toml
Restart=on-failure
RestartSec=2
# SIGTERM performs the DLEP Session Termination exchange before exit.
KillSignal=SIGTERM
# Default termination wait is 4 * 60s; allow transport writes and scheduling.
# Increase this if heartbeat_interval_ms or termination_timeout_ms is increased.
TimeoutStopSec=300s

# Outbound TCP and ephemeral UDP source ports need no bind capability.
# Strict TCP GTSM requires packet monitoring.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# Hardening
# Static service user so PKI keys can be owned root:dlep mode 0640.
# Create once with: useradd --system --no-create-home --shell /usr/sbin/nologin dlep
User=dlep
Group=dlep
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
# AF_PACKET is required by GTSM; AF_NETLINK by interface enumeration.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ReadOnlyPaths=/etc/dlep

[Install]
WantedBy=multi-user.target
