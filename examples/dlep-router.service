[Unit]
Description=DLEP router-side daemon (RFC 8175)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dlep-router --config /etc/dlep/router.toml
Restart=on-failure
RestartSec=2

# Port 854 is privileged; grant only the bind capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
# Static service user so PKI keys can be owned root:dlep mode 0640.
# Create once with: useradd --system --no-create-home --shell /usr/sbin/nologin dlep
User=dlep
Group=dlep
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/dlep

[Install]
WantedBy=multi-user.target
