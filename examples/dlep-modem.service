[Unit]
Description=DLEP modem-side daemon (RFC 8175)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dlep-modem --config /etc/dlep/modem.toml
Restart=on-failure
RestartSec=2
# SIGTERM performs the DLEP Session Termination exchange before exit.
KillSignal=SIGTERM

# Port 854 needs bind privileges; strict TCP GTSM needs packet monitoring.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Hardening
# Static service user so PKI keys can be owned root:dlep mode 0640.
# Create once with: useradd --system --no-create-home --shell /usr/sbin/nologin dlep
User=dlep
Group=dlep
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/dlep

[Install]
WantedBy=multi-user.target
