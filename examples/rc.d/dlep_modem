#!/bin/sh
# PROVIDE: dlep_modem
# REQUIRE: NETWORKING LOGIN
# KEYWORD: shutdown
#
# Enable with: sysrc dlep_modem_enable=YES
# Uses examples/native/modem.toml, installed under /usr/local/etc/dlep.

. /etc/rc.subr

name="dlep_modem"
rcvar="dlep_modem_enable"
load_rc_config "$name"
: ${dlep_modem_enable:="NO"}

command="/usr/sbin/daemon"
procname="/usr/sbin/daemon"
pidfile="/var/run/${name}.pid"
required_files="/usr/local/etc/dlep/modem.toml"
# Stop the supervisor, which forwards SIGTERM and waits for graceful exit.
# A child PID here would cause the supervisor to restart it on service stop.
# Keep daemon(8) privileged for its PID file; only the DLEP child runs as dlep.
command_args="-c -f -S -s notice -T ${name} -R 2 -P ${pidfile} -u dlep /usr/local/bin/dlep-modem --config /usr/local/etc/dlep/modem.toml"
umask 027

run_rc_command "$1"
